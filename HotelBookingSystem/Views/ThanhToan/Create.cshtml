@model HotelBookingSystem.Models.ThanhToan

@{
    ViewData["Title"] = "Thanh toán";
    var datPhong = ViewBag.DatPhong as HotelBookingSystem.Models.DatPhong;
}

<div class="container py-4">

    <h2 class="mb-4">Thanh toán đặt phòng</h2>

    <div class="card shadow-sm">

        <div class="card-body">

            <h5 class="mb-3">Thông tin đặt phòng</h5>

            <p>
                <strong>Mã đặt phòng:</strong>
                #@datPhong?.MaDatPhong
            </p>

            <p>
                <strong>Ngày đặt:</strong>
                @datPhong?.NgayDat.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Trạng thái:</strong>
                <span class="badge bg-success">
                    @datPhong?.TrangThai
                </span>
            </p>

            <hr />

            <h5 class="mb-3">Thông tin thanh toán</h5>

            <div class="mb-3">
                <strong>Số tiền cần thanh toán:</strong>

                <span class="text-danger fw-bold fs-4">
                    @datPhong?.TongTien.ToString("N0") VNĐ
                </span>
            </div>

            <form asp-action="Create" method="post">

                <input type="hidden"
                       asp-for="MaDatPhong" />

                <div class="mb-3">

                    <label class="form-label">
                        Phương thức thanh toán
                    </label>

                    <select name="phuongThucThanhToan"
                            class="form-select">

                        <option value="">
                            -- Chọn phương thức --
                        </option>

                        <option value="Tiền mặt">
                            Tiền mặt
                        </option>

                        <option value="Chuyển khoản">
                            Chuyển khoản
                        </option>

                    </select>

                    <span asp-validation-for="PhuongThucThanhToan"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Thanh toán
                    </button>

                    <a asp-controller="Home"
                           asp-action="BookingHistory"
                           class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}