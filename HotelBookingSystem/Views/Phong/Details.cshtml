@model HotelBookingSystem.Models.ViewModels.PhongHinhAnhViewModel

@{
    ViewData["Title"] = "Chi tiết phòng";
}

<h2>Chi tiết phòng</h2>

<div class="card my-3">
    <div class="card-body">
        <p><strong>Số phòng:</strong> @Model.Phong.SoPhong</p>
        <p><strong>Tên phòng:</strong> @Model.Phong.TenPhong</p>
        <p><strong>Loại phòng:</strong> @Model.Phong.LoaiPhong?.TenLoaiPhong</p>
        <p><strong>Giá một đêm:</strong> @Model.Phong.GiaMotDem.ToString("N0") VNĐ</p>
        <p><strong>Sức chứa:</strong> @Model.Phong.SucChua</p>
        <p><strong>Mô tả:</strong> @Model.Phong.MoTa</p>
        <p><strong>Trạng thái:</strong> @Model.Phong.TrangThai</p>
    </div>
</div>

<hr />

<h4>Hình ảnh phòng</h4>

@if (Model.DanhSachAnh.Any())
{
    <div class="row">
        @foreach (var item in Model.DanhSachAnh)
        {
            <div class="col-md-4 mb-3">
                <img src="@item.DuongDanAnh"
                     class="img-fluid rounded border"
                     alt="Hình ảnh phòng" />
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">Chưa có hình ảnh.</p>
}

<a asp-action="Index" class="btn btn-secondary">
    Quay lại
</a>