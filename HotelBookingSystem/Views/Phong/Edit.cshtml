@model HotelBookingSystem.Models.Phong

@{
    ViewData["Title"] = "Sửa phòng";
}
<h2>Sửa phòng</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaPhong" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="MaLoaiPhong" class="form-label"></label>

    <select asp-for="MaLoaiPhong"
            asp-items="ViewBag.LoaiPhongList"
            class="form-select">
    </select>
    <span asp-validation-for="MaLoaiPhong" class="text-danger"></span>
    <div class="mb-3">
        <label asp-for="SoPhong" class="form-label"></label>

        <input asp-for="SoPhong" class="form-control" />

        <span asp-validation-for="SoPhong" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TenPhong" class="form-label"></label>

        <input asp-for="TenPhong" class="form-control" />

        <span asp-validation-for="TenPhong" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="GiaMotDem" class="form-label"></label>

        <input asp-for="GiaMotDem" class="form-control" />

        <span asp-validation-for="GiaMotDem" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SucChua" class="form-label"></label>

        <input asp-for="SucChua" class="form-control" />

        <span asp-validation-for="SucChua" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MoTa" class="form-label"></label>

        <textarea asp-for="MoTa" class="form-control"></textarea>

        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TrangThai" class="form-label"></label>

        <input asp-for="TrangThai" class="form-control" />

        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">
        Lưu
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Quay lại
    </a>

</form>
